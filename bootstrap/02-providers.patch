@@ -253,6 +253,51 @@
     console.log(chalk.green('OpenRouter configured successfully!'));
   }
 
+  async setupCompatibleProviderCredentials(providerId, keyUrl) {
+    const preset = PROVIDERS[providerId];
+    if (!preset) throw new Error(`Unknown AI provider: ${providerId}`);
+
+    console.log(chalk.cyan(`\n${preset.name} Setup`));
+    console.log(chalk.gray(`Get your API key from: ${keyUrl}`));
+
+    const answers = await inquirer.prompt([
+      {
+        type: 'password',
+        name: 'apiKey',
+        message: `Enter your ${preset.name} API Key:`,
+        validate: input => input.length > 0 || 'API key is required'
+      },
+      {
+        type: 'list',
+        name: 'model',
+        message: 'Select model:',
+        choices: [...preset.models],
+        default: preset.defaultModel
+      }
+    ]);
+
+    this.credentials.aiProvider = {
+      provider: providerId,
+      apiKey: answers.apiKey,
+      model: answers.model
+    };
+
+    await this.saveCredentials();
+    console.log(chalk.green(`${preset.name} configured successfully!`));
+  }
+
+  async setupNvidiaCredentials() {
+    return this.setupCompatibleProviderCredentials('nvidia', 'https://build.nvidia.com/');
+  }
+
+  async setupGroqCredentials() {
+    return this.setupCompatibleProviderCredentials('groq', 'https://console.groq.com/keys');
+  }
+
+  async setupCerebrasCredentials() {
+    return this.setupCompatibleProviderCredentials('cerebras', 'https://cloud.cerebras.ai/');
+  }
+
   // Kimi (Moonshot AI) Setup
